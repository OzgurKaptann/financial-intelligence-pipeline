# =============================================================================
# metabase/.env.example
#
# Template environment file for the Phase 2 Metabase + PostgreSQL Docker stack.
#
# HOW TO USE:
#   1. Copy this file to metabase/.env
#      cp metabase/.env.example metabase/.env        (Mac/Linux)
#      copy metabase\.env.example metabase\.env      (Windows CMD)
#
#   2. Replace every value that says replace_me_* with a real password.
#      Passwords are only used locally — they never leave your machine.
#
#   3. Never commit metabase/.env — it is in .gitignore.
#      This file (metabase/.env.example) is safe to commit.
#
# =============================================================================

# Docker Compose project name (prefixes all container and volume names)
COMPOSE_PROJECT_NAME=financial-intelligence-metabase

# ---------------------------------------------------------------------------
# Metabase UI
# ---------------------------------------------------------------------------
METABASE_PORT=3000

# ---------------------------------------------------------------------------
# analytics_postgres — financial source tables and transform outputs
# Host port 5433 (avoids conflict with any local PostgreSQL on 5432)
# ---------------------------------------------------------------------------
POSTGRES_ANALYTICS_DB=financial_analytics
POSTGRES_ANALYTICS_USER=analytics_user
POSTGRES_ANALYTICS_PASSWORD=replace_me_analytics_password
POSTGRES_ANALYTICS_PORT=5433

# ---------------------------------------------------------------------------
# metabase_app_db — Metabase internal application metadata
# Host port 5434 (debug access only; not needed for normal usage)
# ---------------------------------------------------------------------------
POSTGRES_METABASE_DB=metabase_app
POSTGRES_METABASE_USER=metabase_user
POSTGRES_METABASE_PASSWORD=replace_me_metabase_password
POSTGRES_METABASE_PORT=5434
