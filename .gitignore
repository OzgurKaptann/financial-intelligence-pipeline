# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environments
.env
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data folders — raw inputs, extracted intermediates, and final outputs
# are excluded from version control to avoid committing large or sensitive files.
# .gitkeep files are explicitly kept so folder structure is tracked.
data/raw_documents/*
!data/raw_documents/.gitkeep

data/processed_markdown/*
!data/processed_markdown/.gitkeep
# Ignore generated Markdown outputs and the conversion manifest by default.
# The .gitkeep preserves the folder in git.
# To commit a sample manifest for demo purposes, explicitly git add it.

data/extracted/*
!data/extracted/.gitkeep
# Ignore generated extraction outputs (CSV, JSON, MD) by default.
# Re-add explicitly with git add -f if you want to commit a sample for demo purposes.

data/final/*
!data/final/.gitkeep

# Databases
*.sqlite
*.db

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code local settings (contains machine-specific paths)
.claude/

# =============================================================================
# Phase 2 — Metabase + PostgreSQL + Docker experiment
# =============================================================================

# Local environment files (credentials — never commit)
.env.*
metabase/.env
metabase/.env.*

# Keep the example template — it contains only placeholder values, no secrets
!metabase/.env.example

# Metabase local application state
metabase/metabase.db
metabase/metabase.db.*
metabase/plugins/
metabase/logs/
metabase/tmp/

# Docker / PostgreSQL local volume data
metabase_db/
postgres_data/
postgres_metabase_data/
docker-data/
volumes/

# Generated Phase 2 exports and temp files
metabase/exports/
metabase/screenshots/*.png
metabase/screenshots/*.jpg
metabase/screenshots/*.jpeg

# Keep the screenshots folder placeholder
!metabase/screenshots/.gitkeep
